# Copy to .env to override.

PORT=5000

# Base URL of the Python detection/drift/AIS-scoring service.
PYTHON_SERVICE_URL=http://localhost:8000

# When true (default), GET /api/incidents/:id serves pre-cached results for
# known demo incidents (see src/data/demo/) instead of running the live
# pipeline. Hackathon shortcut for demo reliability — see API_CONTRACT.md,
# "Notes for demo reliability". Set to false to force live orchestration.
DEMO_MODE=true

# Origin allowed to call this API (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173
